# ==============================================================================
# agentK Environment Configuration
# ==============================================================================

# Supabase Credentials (Get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# X (Twitter) Watcher Account Credentials
# (Dedicated account for monitoring user profiles and bio verification)
# ------------------------------------------------------------------------------
WATCHER_TWITTER_AUTH_TOKEN=
WATCHER_TWITTER_CT0=

# ------------------------------------------------------------------------------
# X (Twitter) Agent Account Credentials
# (Dedicated account for agent interactions and autonomous actions)
# ------------------------------------------------------------------------------
AGENT_TWITTER_AUTH_TOKEN=
AGENT_TWITTER_CT0=

# ------------------------------------------------------------------------------
# Groq LLM API Configuration (Model: qwen/qwen3.8-27b)
# (Used for analyzing and classifying candidate contribution tweets)
# ------------------------------------------------------------------------------
GROQ_API_KEY=

# Session Security Secret
SESSION_SECRET=agentk_secure_random_session_secret_key_2026

